# Copia este archivo con el nombre .env y escribe tus propios valores.
#   PowerShell:  copy .env.example .env
#   CMD:         copy .env.example .env
# El archivo .env NO se sube al repositorio (esta en .gitignore).

# Puerto donde arranca la API y la pagina (4700 para poder ver las dos demos a la vez)
PORT=4700

# Conexion a MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=tu_contrasena_de_mysql
DB_NAME=demo_sesiones

# Opcional: secreto con el que se firma la cookie de sesion.
# Si no existe, el servidor usa el secreto de la demo.
# SESSION_SECRET=cambia_esto_por_una_cadena_larga

# Opcional: secreto con el que se firma el token JWT.
# Si no existe, el servidor usa el secreto de la demo.
# JWT_SECRET=cambia_esto_por_otra_cadena_larga
